# Copy to .env (git-ignored) and fill in. Never commit .env.
GROQ_API_KEY=

# Hard caps for scripts/run_llm.py. The run stops BEFORE any request that could exceed them.
# Groq Free plan for openai/gpt-oss-120b: 30 requests/min, 1,000 requests/day,
# 8,000 tokens/min, 200,000 tokens/day; requests over a limit are refused, not billed.
LLM_MAX_TOKENS_PER_DAY=150000
# USD cap at Groq's paid Developer-plan prices (only matters if the account is upgraded).
LLM_MAX_USD_TOTAL=0.50
LLM_TOKENS_PER_MINUTE=7000
LLM_REQUESTS_PER_MINUTE=25
LLM_MAX_COMPLETION_TOKENS=4096
